# Copy to .env.local and fill in. Never commit .env.local.
# Anything prefixed VITE_ is bundled into the browser and is PUBLIC (see Security Spec §2).

# Supabase: accounts and saved missions (optional; the app works without them). Setup: README.md.
# The anon key is safe in the browser ONLY with Row Level Security on for every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets go in Vercel -> Environment Variables, without the VITE_ prefix.
# None are needed yet.
